{
  "name": "permissionManager",
  "publisher": "SaurabhMulay",
  "displayName": "Permission Manager",
  "description": "Manage Salesforce Profile and Permission Set permissions directly from VS Code.",
  "version": "0.0.4",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaurabhMulay/PermissionManager.git"
  },
  "contributes": {
    "commands": [
      {
        "command": "permissionManager.updatePermissions",
        "title": "Salesforce: Permission Manager"
      },
      {
        "command": "permissionManager.launchApp",
        "title": "Salesforce: Launch Bulk File Uploader"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
